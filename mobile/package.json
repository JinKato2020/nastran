{
  "name": "nastran-learning",
  "version": "1.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "content": "node tools/bundle-content.mjs",
    "start": "expo start",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "typecheck": "tsc --noEmit",
    "export:ios": "npm run content && expo export --platform ios --output-dir .build/ios",
    "export:ios:js": "npm run content && expo export --platform ios --no-bytecode --output-dir .build/ios-js",
    "test:core": "node tools/check-core.cjs",
    "test:reader": "python tools/check-reader.py"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.0.23",
    "expo-clipboard": "~58.0.4",
    "expo-file-system": "~58.0.13",
    "expo-sharing": "~58.0.22",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-webview": "14.0.1"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "esbuild": "^0.28.2",
    "react-dom": "^19.3.0",
    "react-native-web": "^0.21.4",
    "typescript": "~6.0.3",
    "xcode": "3.0.1"
  }
}
